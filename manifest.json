{
  "manifest_version": 3,
  "name": "Tanvir's LinkedIn AI Comment Generator (Lite)",
  "description": "Free Lite version: generates AI-powered LinkedIn comment replies using OpenAI, Groq, or Gemini APIs. Upgrade to Premium for AI post generation.",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
